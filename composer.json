{
    "name": "nobuhiko/twig",
    "type": "library",
    "description": "Twig 1.34.0 with security fixes backported, for EC-CUBE 3.0.x shops that cannot move off the versions EC-CUBE 3.0.18 ships",
    "keywords": [
        "templating"
    ],
    "homepage": "http://twig.sensiolabs.org",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@symfony.com",
            "homepage": "http://fabien.potencier.org",
            "role": "Lead Developer"
        },
        {
            "name": "Twig Team",
            "homepage": "http://twig.sensiolabs.org/contributors",
            "role": "Contributors"
        },
        {
            "name": "Armin Ronacher",
            "email": "armin.ronacher@active-4.com",
            "role": "Project Founder"
        }
    ],
    "require": {
        "php": ">=5.3.3"
    },
    "autoload": {
        "psr-0": {
            "Twig_": "lib/"
        },
        "psr-4": {
            "Twig\\": "src/"
        }
    },
    "replace": {
        "twig/twig": "1.34.0"
    },
    "support": {
        "issues": "https://github.com/nobuhiko/twig/issues"
    }
}
